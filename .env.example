# --- Shopify app (set automatically by `shopify app dev`) ---
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=http://localhost:3000
SCOPES=write_payment_gateways,write_payment_sessions

# --- Database ---
DATABASE_URL=file:./dev.sqlite

# --- Payments Apps API ---
PAYMENTS_API_VERSION=2026-07
# Optional override. Supports {shop} and {version} placeholders.
# Point at the mock server for local simulation:
# SHOPIFY_PAYMENTS_GQL_URL=http://localhost:4000/{shop}/payments_apps/api/{version}/graphql.json

# Hard-coded token mode (alternative to OAuth install). Used only when no
# offline OAuth session exists for the shop.
# SHOPIFY_ACCESS_TOKEN=shpua_xxx
# Comma-separated shops allowed to call the session endpoints without an
# OAuth install (simulator / hard-coded token mode).
# STATIC_SHOPS=tap-case-study.myshopify.com

# --- Mock processor ---
MOCK_PROCESSOR_LATENCY_MS=50

# --- Logging ---
LOG_LEVEL=info
# LOG_PRETTY=1
